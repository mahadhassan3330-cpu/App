<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/profile_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fillViewport="true"
    tools:context=".ProfileActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/padding_medium">

        <!-- Header Hero Profile Banner Card (RelativeLayout) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_medium"
            app:cardBackgroundColor="@color/colorPrimary"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="@dimen/card_elevation">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/padding_large">

                <!-- Circular Avatar -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/avatar_card"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="@dimen/margin_large"
                    app:cardCornerRadius="45dp"
                    app:cardElevation="2dp">

                    <ImageView
                        android:id="@+id/profile_image"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/profile_title"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_person" />

                </androidx.cardview.widget.CardView>

                <!-- User Name -->
                <TextView
                    android:id="@+id/profile_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignTop="@id/avatar_card"
                    android:layout_toEndOf="@id/avatar_card"
                    android:text="Muhammad Azhar"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <!-- Role / Title -->
                <TextView
                    android:id="@+id/profile_role"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/profile_name"
                    android:layout_marginTop="4dp"
                    android:layout_toEndOf="@id/avatar_card"
                    android:text="@string/profile_role"
                    android:textColor="#E0E0E0"
                    android:textSize="@dimen/text_size_medium" />

                <!-- Location / Company -->
                <TextView
                    android:id="@+id/profile_location"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/profile_role"
                    android:layout_marginTop="4dp"
                    android:layout_toEndOf="@id/avatar_card"
                    android:text="@string/profile_location"
                    android:textColor="#B0BEC5"
                    android:textSize="@dimen/text_size_small"
                    android:textStyle="italic" />

            </RelativeLayout>

        </androidx.cardview.widget.CardView>

        <!-- Stats Bar Card (LinearLayout Horizontal) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_medium"
            app:cardBackgroundColor="@color/card_background"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="@dimen/card_elevation">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:padding="@dimen/padding_medium">

                <!-- Stat 1: Projects -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="18+"
                        android:textColor="@color/colorPrimary"
                        android:textSize="@dimen/text_size_large"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_stats_projects"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_size_small" />

                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/border_color" />

                <!-- Stat 2: Rating -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4.9 ★"
                        android:textColor="@color/colorPrimary"
                        android:textSize="@dimen/text_size_large"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_stats_rating"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_size_small" />

                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/border_color" />

                <!-- Stat 3: Experience -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="5 Yrs"
                        android:textColor="@color/colorPrimary"
                        android:textSize="@dimen/text_size_large"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_stats_exp"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_size_small" />

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Digital Student ID Card Section Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_small"
            android:text="@string/label_student_card"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_size_large"
            android:textStyle="bold" />

        <!-- Student Card (CardView containing ConstraintLayout) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardViewStudent"
            android:layout_width="match_parent"
            android:layout_height="230dp"
            android:layout_marginBottom="@dimen/margin_medium"
            app:cardCornerRadius="12dp"
            app:cardElevation="8dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/card_bg_green">

                <!-- Header Background -->
                <View
                    android:id="@+id/header_bg"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:background="@color/card_header_bg"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHeight_percent="0.22"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:id="@+id/ivLogo"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp"
                    android:contentDescription="@string/app_name"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_app_logo"
                    app:layout_constraintBottom_toBottomOf="@+id/header_bg"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintWidth_percent="0.16" />

                <TextView
                    android:id="@+id/tvUniName1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/uni_name_1"
                    android:textColor="@color/card_text_dark_blue"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toTopOf="@+id/tvUniName2"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/ivLogo"
                    app:layout_constraintTop_toTopOf="@+id/header_bg"
                    app:layout_constraintVertical_chainStyle="packed" />

                <TextView
                    android:id="@+id/tvUniName2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/uni_name_2"
                    android:textColor="@color/card_text_dark_blue"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toTopOf="@+id/tvUniAddress"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/ivLogo"
                    app:layout_constraintTop_toBottomOf="@+id/tvUniName1" />

                <TextView
                    android:id="@+id/tvUniAddress"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/uni_address"
                    android:textColor="@color/card_text_light_blue"
                    android:textSize="7sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="@+id/header_bg"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/ivLogo"
                    app:layout_constraintTop_toBottomOf="@+id/tvUniName2" />

                <!-- Header Bottom Divider Line -->
                <View
                    android:layout_width="0dp"
                    android:layout_height="2dp"
                    android:background="#005C33"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/header_bg" />

                <!-- Vertical "Student" Label on Left -->
                <TextView
                    android:id="@+id/tvStudentLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="-16dp"
                    android:rotation="-90"
                    android:text="@string/label_student"
                    android:textColor="@color/card_text_light_blue"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/header_bg" />

                <!-- Field Guidelines -->
                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/guidelineLabels"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintGuide_percent="0.15" />

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/guidelineColons"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintGuide_percent="0.38" />

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/guidelineValues"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintGuide_percent="0.41" />

                <!-- Field 1: Name -->
                <TextView
                    android:id="@+id/lbl_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/label_name"
                    android:textColor="@color/card_text_yellow"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toEndOf="@+id/guidelineLabels"
                    app:layout_constraintTop_toBottomOf="@+id/header_bg" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=":"
                    android:textColor="@color/card_text_yellow"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="@+id/lbl_name"
                    app:layout_constraintStart_toEndOf="@+id/guidelineColons"
                    app:layout_constraintTop_toTopOf="@+id/lbl_name" />

                <TextView
                    android:id="@+id/val_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Muhammad Azhar"
                    android:textColor="@color/card_text_yellow"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="@+id/lbl_name"
                    app:layout_constraintEnd_toStartOf="@+id/ivPhoto"
                    app:layout_constraintStart_toEndOf="@+id/guidelineValues"
                    app:layout_constraintTop_toTopOf="@+id/lbl_name" />

                <!-- Field 2: Class -->
                <TextView
                    android:id="@+id/lbl_class"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/label_class"
                    android:textColor="@color/card_text_yellow"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toEndOf="@+id/guidelineLabels"
                    app:layout_constraintTop_toBottomOf="@+id/lbl_name" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=":"
                    android:textColor="@color/card_text_yellow"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="@+id/lbl_class"
                    app:layout_constraintStart_toEndOf="@+id/guidelineColons"
                    app:layout_constraintTop_toTopOf="@+id/lbl_class" />

                <TextView
                    android:id="@+id/val_class"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="BS (CS)"
                    android:textColor="@color/card_text_yellow"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="@+id/lbl_class"
                    app:layout_constraintEnd_toStartOf="@+id/ivPhoto"
                    app:layout_constraintStart_toEndOf="@+id/guidelineValues"
                    app:layout_constraintTop_toTopOf="@+id/lbl_class" />

                <!-- Field 3: Reg No -->
                <TextView
                    android:id="@+id/lbl_reg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/label_reg_no"
                    android:textColor="@color/card_text_yellow"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toEndOf="@+id/guidelineLabels"
                    app:layout_constraintTop_toBottomOf="@+id/lbl_class" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=":"
                    android:textColor="@color/card_text_yellow"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="@+id/lbl_reg"
                    app:layout_constraintStart_toEndOf="@+id/guidelineColons"
                    app:layout_constraintTop_toTopOf="@+id/lbl_reg" />

                <TextView
                    android:id="@+id/val_reg"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="24108101"
                    android:textColor="@color/card_text_yellow"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="@+id/lbl_reg"
                    app:layout_constraintEnd_toStartOf="@+id/ivPhoto"
                    app:layout_constraintStart_toEndOf="@+id/guidelineValues"
                    app:layout_constraintTop_toTopOf="@+id/lbl_reg" />

                <!-- Field 4: Issue Date -->
                <TextView
                    android:id="@+id/lbl_issue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/label_issue_date"
                    android:textColor="@color/card_text_yellow"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toEndOf="@+id/guidelineLabels"
                    app:layout_constraintTop_toBottomOf="@+id/lbl_reg" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=":"
                    android:textColor="@color/card_text_yellow"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="@+id/lbl_issue"
                    app:layout_constraintStart_toEndOf="@+id/guidelineColons"
                    app:layout_constraintTop_toTopOf="@+id/lbl_issue" />

                <TextView
                    android:id="@+id/val_issue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Oct 2024"
                    android:textColor="@color/card_text_yellow"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="@+id/lbl_issue"
                    app:layout_constraintEnd_toStartOf="@+id/ivPhoto"
                    app:layout_constraintStart_toEndOf="@+id/guidelineValues"
                    app:layout_constraintTop_toTopOf="@+id/lbl_issue" />

                <!-- Field 5: Valid Upto -->
                <TextView
                    android:id="@+id/lbl_valid"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/label_valid_upto"
                    android:textColor="@color/card_text_yellow"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toEndOf="@+id/guidelineLabels"
                    app:layout_constraintTop_toBottomOf="@+id/lbl_issue" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=":"
                    android:textColor="@color/card_text_yellow"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="@+id/lbl_valid"
                    app:layout_constraintStart_toEndOf="@+id/guidelineColons"
                    app:layout_constraintTop_toTopOf="@+id/lbl_valid" />

                <TextView
                    android:id="@+id/val_valid"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Sep 2028"
                    android:textColor="@color/card_text_yellow"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="@+id/lbl_valid"
                    app:layout_constraintEnd_toStartOf="@+id/ivPhoto"
                    app:layout_constraintStart_toEndOf="@+id/guidelineValues"
                    app:layout_constraintTop_toTopOf="@+id/lbl_valid" />

                <!-- Field 6: CNIC -->
                <TextView
                    android:id="@+id/lbl_cnic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/label_cnic"
                    android:textColor="@color/card_text_yellow"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toEndOf="@+id/guidelineLabels"
                    app:layout_constraintTop_toBottomOf="@+id/lbl_valid" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=":"
                    android:textColor="@color/card_text_yellow"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="@+id/lbl_cnic"
                    app:layout_constraintStart_toEndOf="@+id/guidelineColons"
                    app:layout_constraintTop_toTopOf="@+id/lbl_cnic" />

                <TextView
                    android:id="@+id/val_cnic"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="12101-1051998-3"
                    android:textColor="@color/card_text_yellow"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="@+id/lbl_cnic"
                    app:layout_constraintEnd_toStartOf="@+id/ivPhoto"
                    app:layout_constraintStart_toEndOf="@+id/guidelineValues"
                    app:layout_constraintTop_toTopOf="@+id/lbl_cnic" />

                <!-- Right Student Photo -->
                <ImageView
                    android:id="@+id/ivPhoto"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/photo_bg"
                    android:contentDescription="@string/app_name"
                    android:padding="2dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/student_photo"
                    app:layout_constraintDimensionRatio="3:4"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/header_bg"
                    app:layout_constraintWidth_percent="0.24" />

                <!-- Signature & Administration Manager -->
                <TextView
                    android:id="@+id/tvManager"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/label_manager"
                    android:textColor="#000000"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/ivSignature" />

                <ImageView
                    android:id="@+id/ivSignature"
                    android:layout_width="40dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="20dp"
                    android:contentDescription="@string/label_manager"
                    android:scaleType="fitCenter"
                    android:src="@drawable/signature"
                    app:layout_constraintBottom_toBottomOf="@+id/tvManager"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/tvManager" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.cardview.widget.CardView>

        <!-- Contact & Personal Information Card (LinearLayout) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_medium"
            app:cardBackgroundColor="@color/card_background"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="@dimen/card_elevation">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/padding_medium">

                <!-- Row 1: Email -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="@dimen/padding_small">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="@dimen/margin_medium"
                        android:contentDescription="Email"
                        android:src="@drawable/ic_email" />

                    <TextView
                        android:id="@+id/tvProfileEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_email_label"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_size_medium" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/border_color" />

                <!-- Row 2: Phone -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="@dimen/padding_small">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="@dimen/margin_medium"
                        android:contentDescription="Phone"
                        android:src="@drawable/ic_phone" />

                    <TextView
                        android:id="@+id/tvProfilePhone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_phone"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_size_medium" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/border_color" />

                <!-- Row 3: Location -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="@dimen/padding_small">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="@dimen/margin_medium"
                        android:contentDescription="Location"
                        android:src="@drawable/ic_location" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_location"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_size_medium" />

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Technical Skills Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_small"
            android:text="@string/skills_title"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_size_large"
            android:textStyle="bold" />

        <!-- GridLayout for Skills with Card Badges -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_medium"
            android:alignmentMode="alignMargins"
            android:columnCount="5"
            android:useDefaultMargins="true">

            <!-- Skill 1: Android -->
            <androidx.cardview.widget.CardView
                android:id="@+id/skill_android"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:clickable="true"
                android:focusable="true"
                android:onClick="onSkillClick"
                app:cardBackgroundColor="@color/card_background"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:contentDescription="Android"
                        android:src="@drawable/ic_app_logo" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Android"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Skill 2: Java -->
